# Copy to /etc/wardotfun/wardotfun.env with mode 0600.
WARDOTFUN_DATABASE_URL=postgresql://wardotfun:CHANGE_ME@127.0.0.1:5432/wardotfun
WARDOTFUN_RAW_ARCHIVE_DIR=/var/lib/wardotfun/raw-archive
WARDOTFUN_BACKUP_DIR=/var/backups/wardotfun-postgres
WARDOTFUN_DISK_PATH=/var/lib/docker
WARDOTFUN_DISK_ALERT_PERCENT=70

# Shadow mode: both remain 0 while the worker writes/comparisons run.
WARDOTFUN_POSTGIS_READS_ENABLED=0
WARDOTFUN_VECTOR_TILES_ENABLED=0
WARDOTFUN_AUTO_MIGRATE=0

# Optional generic JSON webhook used only when a health check fails.
# WARDOTFUN_ALERT_WEBHOOK=https://alerts.example/hooks/...
