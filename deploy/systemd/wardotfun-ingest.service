[Unit]
Description=wardotfun temporal map ingestion worker
After=network-online.target postgresql.service wardotfun.service
Wants=network-online.target wardotfun.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wardotfun
EnvironmentFile=/etc/wardotfun/wardotfun.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/wardotfun/.venv/bin/python -m backend.ingestion_worker
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
