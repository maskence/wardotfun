[Unit]
Description=wardotfun temporal map ingestion worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=wardotfun
Group=wardotfun
WorkingDirectory=/opt/wardotfun
EnvironmentFile=/etc/wardotfun/wardotfun.env
ExecStart=/opt/wardotfun/env/bin/python -m backend.ingestion_worker
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wardotfun /opt/wardotfun/backend/data/mapper_cache /opt/wardotfun/backend/data/geoconfirmed_icons

[Install]
WantedBy=multi-user.target
