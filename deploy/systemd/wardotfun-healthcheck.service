[Unit]
Description=wardotfun temporal storage health and alert checks
After=wardotfun-ingest.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wardotfun
EnvironmentFile=/etc/wardotfun/wardotfun.env
ExecStart=/home/ubuntu/wardotfun/.venv/bin/python -m backend.ops_healthcheck
NoNewPrivileges=true
