[Unit]
Description=wardotfun temporal storage health and alert checks
After=wardotfun-ingest.service

[Service]
Type=oneshot
User=wardotfun
Group=wardotfun
WorkingDirectory=/opt/wardotfun
EnvironmentFile=/etc/wardotfun/wardotfun.env
ExecStart=/opt/wardotfun/env/bin/python -m backend.ops_healthcheck
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
